# Navaveij Environment Configuration (Example)

# --- AI Model Configuration (OpenAI Compatible) ---

# Choice 1: Google Gemini (Cloud)
# LLM_API_KEY=AIzaSy... (Get from Google AI Studio)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-1.5-flash

# Choice 2: Local LLM (e.g., LM Studio, Ollama)
LLM_API_KEY=          # Can be empty for local
LLM_BASE_URL=http://127.0.0.1:1234/v1/
LLM_MODEL=meta-llama-3.1-8b-instruct
LLM_PROVIDER=local

# --- MCP Server Configuration ---
MCP_SERVER_COMMAND=uv
MCP_SERVER_ARGS=["run", "python", "-m", "src.mcp_server.server"]

# --- General Settings ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
