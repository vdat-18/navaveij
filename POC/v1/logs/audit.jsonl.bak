trend_data_note": null, "sdm_note": null}], "ascvd_10yr_risk": {"score": 0.014, "score_pct": 1.4, "category": "Low", "category_label": "Low risk (<5%)", "inputs_used": {"age": 35, "sex": "male", "race": "other", "total_cholesterol": 189.0, "hdl": 60.0, "systolic_bp": 116, "bp_treatment": false, "diabetes": false, "smoking": "never"}, "guideline": "ACC/AHA Pooled Cohort Equations 2013/2018", "note": "Age 35 male with normal lipids and BP; clinical focus remains primary prevention through healthy lifestyle."}, "waist_circumference": {"value": 82.0, "unit": "cm", "threshold_male_asian": 90.0, "category": "Normal", "note": "Within healthy range for Asian male profile."}, "computed_at": "2026-03-15T03:00:00Z", "pipeline_run_id": "pipe_20260315_0300"}, "get_program_ruleset": {"patient_token": "tok_hmac_965c8137", "ruleset_version": "v2026.03.1-draft", "admin_last_updated": "2026-03-13T00:00:00Z", "computed_at": "2026-03-16T03:59:02.653355Z", "tier_selection_rules": [{"rule_id": "PREMIUM_SEVERE_SINGLE", "priority": 1, "tier": "Premium", "match_logic": "ANY", "_clinical_rationale": "A single high-severity condition that places the patient in active multi-organ disease or imminent serious-outcome territory. Any one is sufficient to warrant the Diamond (Premium) program.", "_expert_review_note": "Please confirm: are these the correct conditions for mandatory Premium escalation? Should any be Advanced instead?", "conditions": [{"type": "signal_active", "signal_ids": ["ckd_rapid_progression"], "description": "CKD rapid progression \u2014 eGFR annual decline > 5 mL/min/1.73m\u00b2. KDIGO 2022: urgent nephrology referral; comprehensive evaluation warranted beyond Advanced.", "guideline_ref": "clinical-guidelines-reference.md \u00a77.2"}, {"type": "signal_active", "signal_ids": ["ascvd_very_high"], "description": "ASCVD 10-year risk \u2265 20%. ACC/AHA 2013/2018: high-intensity statin mandatory + comprehensive cardiovascular workup beyond standard Enhanced screening.", "guideline_ref": "clinical-guidelines-reference.md \u00a75.1"}, {"type": "signal_active", "signal_ids": ["hypertensive_crisis"], "description": "Hypertensive crisis \u2014 SBP > 180 OR DBP > 120. ACC/AHA 2017: emergency evaluation; EST and contrast procedures contraindicated. Cannot proceed with routine checkup without specialist clearance.", "guideline_ref": "clinical-guidelines-reference.md \u00a72"}, {"type": "signal_active", "signal_ids": ["diabetes_confirmed"], "and_signal_active": ["dm_organ_complication_screening"], "description": "Confirmed DM (HbA1c \u2265 6.5%) with active organ complication screening gap \u2014 at least one of: retinopathy, nephropathy, neuropathy, or cardiac screening overdue. ADA 2024: multi-organ surveillance program required.", "guideline_ref": "clinical-guidelines-reference.md \u00a71.2, \u00a76.2"}, {"type": "signal_active", "signal_ids": ["liver_enzyme_elevation_significant"], "and_signal_active": ["fibroscan_indication"], "description": "ALT > 3\u00d7 ULN (significant hepatocellular injury) combined with liver disease risk indicator (NAFLD, alcohol, or high TG). AASLD 2023: comprehensive hepatic evaluation required \u2014 beyond basic LFT add-on.", "guideline_ref": "clinical-guidelines-reference.md \u00a71.4, \u00a78.1"}], "guideline_basis": "TOR \u00a73.2: Risk Level High \u2192 Premium/Personalized Package", "admin_configurable": {"tier_assignment": false, "conditions": false, "_note": "No admin-configurable fields. Any change to conditions requires clinical review and code release."}}, {"rule_id": "PREMIUM_MULTI_SIGNAL", "priority": 2, "tier": "Premium", "match_logic": "COUNT_THRESHOLD", "_clinical_rationale": "Convergence of multiple independent moderate-severity risk signals across organ systems. Even without a single dominant condition, the cumulative burden exceeds what an Advanced (Platinum) package with add-ons can adequately address.", "_expert_review_note": "CRITICAL CALIBRATION ITEM. The sample patient Somchai W. (sample_patient_checkup.json) fires 8 of 12 signals in this pool: prediabetes_confirmed, htn_active, dyslipidemia_active, ascvd_risk_intermediate, family_hx_premature_cad, at_risk_alcohol_use, lung_ct_threshold_met, uric_acid_hyperuricemia. With min_count: 5, Somchai resolves to Premium. Clinical question: Is Premium (Diamond) appropriate for Somchai's profile, or should he remain Advanced (Platinum)? If Somchai should be Advanced, either (a) raise min_count to 9, or (b) remove some signals from the pool (e.g., uric_acid_hyperuricemia, at_risk_alcohol_use) to reduce his match count below the threshold.", "conditions": [{"type": "signal_count_threshold", "signal_pool": ["prediabetes_confirmed", "htn_active", "dyslipidemia_active", "bmi_obese_asian", "ascvd_risk_intermediate", "bp_stage2_htn", "family_hx_premature_cad", "at_risk_alcohol_use", "fibroscan_indication", "lung_ct_threshold_met", "ckd_comorbidity", "uric_acid_hyperuricemia"], "min_count": 5, "description": "\u2265 5 of 12 moderate-severity risk signals active simultaneously \u2014 indicates multi-system disease burden requiring comprehensive Premium evaluation.", "_signal_pool_rationale": {"prediabetes_confirmed": "Metabolic \u2014 pre-DM; organ risk precursor", "htn_active": "Cardiovascular \u2014 confirmed hypertension comorbidity", "dyslipidemia_active": "Cardiovascular \u2014 confirmed dyslipidemia comorbidity", "bmi_obese_asian": "Metabolic \u2014 Asian-adjusted obese (BMI \u2265 27.5); high NCD risk", "ascvd_risk_intermediate": "Cardiovascular \u2014 10-yr risk 7.5\u201319.9%; significant CV burden", "bp_stage2_htn": "Cardiovascular \u2014 Stage 2 HTN (SBP \u2265 140 or DBP \u2265 90)", "family_hx_premature_cad": "Genetic \u2014 first-degree premature CAD; ACC/AHA risk enhancer", "at_risk_alcohol_use": "Behavioral \u2014 AUDIT-C positive; liver + metabolic risk", "fibroscan_indication": "Hepatic \u2014 liver disease risk from BMI + ALT or alcohol + ALT", "lung_ct_threshold_met": "Oncologic \u2014 LDCT-eligible smoker; significant cancer risk", "ckd_comorbidity": "Renal \u2014 confirmed CKD any stage", "uric_acid_hyperuricemia": "Metabolic \u2014 hyperuricemia; associated with metabolic syndrome"}}], "guideline_basis": "TOR \u00a73.2: Risk Level High \u2192 Premium/Personalized Package", "admin_configurable": {"min_count": true, "min_count_range": {"min": 3, "max": 12}, "signal_pool": false, "_note": "Admin may adjust min_count via Admin Panel. Signal pool membership requires code release + clinical review. Final threshold must be validated by MAT."}}, {"rule_id": "ADVANCED_METABOLIC_OR_CVD", "priority": 3, "tier": "Advanced", "match_logic": "ANY", "_clinical_rationale": "Any single moderate-severity signal places the patient into elevated-risk territory requiring enhanced (Platinum) screening beyond the standard annual package. Alternatively, two or more lower-severity signals co-occurring indicates sufficient cumulative risk.", "_expert_review_note": "Please verify: (1) Are all 7 single-signal qualifiers appropriate for Advanced? Should any be Standard instead? (2) Is min_count: 2 the right threshold for the low-moderate pool? (3) Are all 13 low-moderate pool signals correctly categorized?", "conditions": [{"type": "signal_active", "signal_ids": ["prediabetes_confirmed", "diabetes_confirmation_required"], "description": "Pre-diabetes confirmed (FBS 100\u2013125 or HbA1c 5.7\u20136.4%) OR diabetes requiring confirmation (FBS \u2265 126, pending retest). ADA 2024: significantly elevated DM progression risk.", "guideline_ref": "clinical-guidelines-reference.md \u00a71.1, \u00a71.2"}, {"type": "signal_active", "signal_ids": ["ascvd_risk_intermediate"], "description": "ASCVD 10-year risk 7.5\u201319.9% (Intermediate). ACC/AHA 2018: moderate-intensity statin consideration + enhanced cardiovascular screening.", "guideline_ref": "clinical-guidelines-reference.md \u00a75.1"}, {"type": "signal_active", "signal_ids": ["htn_active"], "description": "Active hypertension comorbidity confirmed (Stage 1 or Stage 2 HTN with comorbidity tag). Requires enhanced monitoring beyond Standard package baseline.", "guideline_ref": "clinical-guidelines-reference.md \u00a72"}, {"type": "signal_active", "signal_ids": ["lung_ct_threshold_met"], "description": "LDCT lung cancer screening eligible \u2014 age 50\u201380, \u2265 20 pack-years, current smoker or quit \u2264 15 years. USPSTF 2021 Grade B: annual screening indicated.", "guideline_ref": "clinical-guidelines-reference.md \u00a74.4, \u00a710.1"}, {"type": "signal_active", "signal_ids": ["ckd_comorbidity"], "description": "CKD any stage confirmed. KDIGO 2022: requires structured monitoring and nephrology input beyond Standard baseline.", "guideline_ref": "clinical-guidelines-reference.md \u00a71.5, \u00a77.1"}, {"type": "signal_active", "signal_ids": ["bmi_obese_asian"], "description": "Obese by Asian-adjusted BMI (\u2265 27.5 kg/m\u00b2). WHO Asia-Pacific 2000: significantly elevated NCD risk requiring enhanced metabolic screening.", "guideline_ref": "clinical-guidelines-reference.md \u00a73"}, {"type": "signal_count_threshold", "signal_pool": ["bmi_overweight_asian", "low_hdl", "high_triglycerides", "high_ldl", "bp_stage1_htn", "bp_worsening", "family_hx_premature_cad", "at_risk_alcohol_use", "office_syndrome", "night_shift_worker", "uric_acid_hyperuricemia", "dyslipidemia_active", "fibroscan_indication"], "min_count": 2, "description": "\u2265 2 of 13 low-to-moderate severity signals active simultaneously \u2014 combined risk burden warrants enhanced screening beyond Standard.", "_signal_pool_rationale": {"bmi_overweight_asian": "Asian-adjusted overweight (BMI \u2265 23); elevated metabolic risk", "low_hdl": "HDL < 40 (M) / < 50 (F); CV risk factor", "high_triglycerides": "TG \u2265 200 mg/dL; metabolic + hepatic risk", "high_ldl": "LDL \u2265 160 mg/dL; CV risk", "bp_stage1_htn": "SBP 130\u2013139 or DBP 80\u201389 (ACC/AHA 2017 Stage 1); not yet active comorbidity", "bp_worsening": "BP trend worsening over serial readings", "family_hx_premature_cad": "First-degree premature CAD; ACC/AHA risk enhancer", "at_risk_alcohol_use": "AUDIT-C \u2265 3 (F) / \u2265 4 (M); liver + metabolic risk", "office_syndrome": "Prolonged sedentary desk work; MSK + metabolic risk", "night_shift_worker": "Rotating/permanent night shift; elevated DM + HTN + sleep risk", "uric_acid_hyperuricemia": "Uric acid above sex-specific threshold; metabolic syndrome marker", "dyslipidemia_active": "Confirmed dyslipidemia comorbidity", "fibroscan_indication": "Liver disease risk indicator (AASLD 2023)"}}], "guideline_basis": "TOR \u00a73.2: Risk Level Moderate \u2192 Advanced Package", "admin_configurable": {"min_count": true, "min_count_range": {"min": 2, "max": 5}, "signal_pool": false}}, {"rule_id": "STANDARD_DEFAULT", "priority": 4, "tier": "Standard", "match_logic": "DEFAULT", "_clinical_rationale": "No Premium or Advanced rule matched. Patient has no active elevated-risk signals; routine preventive annual health screening (Gold package) is appropriate.", "conditions": [], "guideline_basis": "TOR \u00a73.2: Risk Level Low \u2192 Standard Package", "admin_configurable": {"tier_assignment": false, "_note": "Default rule cannot be removed or reordered. Tier assignment cannot be changed."}}], "applied_rule_id": "STANDARD_DEFAULT", "applied_condition": null, "rule_preliminary_tier": "Standard", "package_resolution_map": {"Standard": {"male": {"age_15_to_35": {"package_name": "Gold", "package_code": "GOLD_ANY", "price_thb": 5900, "source": "navavej-checkup-package-discovery.md \u00a72"}, "age_36_plus": {"package_name": "Gold", "package_code": "GOLD_ANY", "price_thb": 5900, "source": "navavej-checkup-package-discovery.md \u00a72"}}, "female": {"age_15_to_35": {"package_name": "Gold", "package_code": "GOLD_ANY", "price_thb": 5900, "source": "navavej-checkup-package-discovery.md \u00a72"}, "age_36_plus": {"package_name": "Gold", "package_code": "GOLD_ANY", "price_thb": 5900, "source": "navavej-checkup-package-discovery.md \u00a72"}}}, "Advanced": {"male": {"age_35_plus": {"package_name": "Platinum \u2014 Men", "package_code": "PLAT_M", "price_thb": 8700, "source": "navavej-checkup-package-discovery.md \u00a72"}}, "female": {"age_35_plus": {"package_name": "Platinum \u2014 Women", "package_code": "PLAT_F", "price_thb": 13500, "source": "navavej-checkup-package-discovery.md \u00a72"}}}, "Premium": {"male": {"age_40_plus": {"package_name": "Diamond \u2014 Men", "package_code": "DIAM_M", "price_thb": 15000, "source": "navavej-checkup-package-discovery.md \u00a72"}}, "female": {"age_40_plus": {"package_name": "Diamond \u2014 Women", "package_code": "DIAM_F", "price_thb": 19000, "source": "navavej-checkup-package-discovery.md \u00a72"}}}}, "resolved_package": {"tier": "Standard", "gender": "male", "age": 35, "age_band": "age_15_to_35", "package_name": "Gold", "package_code": "GOLD_ANY", "price_thb": 5900}, "add_on_library": [], "_add_on_library_filtered_count": 0, "_add_on_library_excluded_count": 0, "_add_on_library_excluded_items": []}}}, "why": {"reasoning_trace": "The rule_preliminary_tier is 'Standard', determined by the 'STANDARD_DEFAULT' rule, as the patient, tok_hmac_965c8137, does not meet the criteria for 'Premium' or 'Advanced' tiers. This AI confirms the 'Standard' tier recommendation.\n\nCardiovascular and Metabolic Health: The patient exhibits an excellent cardiovascular and metabolic profile. His BMI is 22.4 kg/m2, which is 'Normal' for an Asian-adjusted threshold, and has been stable. Blood pressure is 'Normal' at 116/72 mmHg and stable. Fasting blood glucose (FBS) is 91.0 mg/dL ('Normal') and HbA1c is 5.3% ('Normal'), both showing stable trends, indicating no prediabetes or diabetes. Lipid profile is favorable, with LDL cholesterol at 109.0 mg/dL ('Near-optimal'), HDL cholesterol at 60.0 mg/dL ('Protective'), and Triglycerides at 100.0 mg/dL ('Normal'). These values contribute to a very low 10-year ASCVD risk of 1.4%, categorized as 'Low' by ACC/AHA guidelines. There is no family history of premature CAD.\n\nKidney and Liver Health: eGFR is 99.0 mL/min/1.73m2, placing the patient in 'CKD Stage G1 \u2014 normal or high', with a stable annual slope, indicating healthy kidney function. Behavioral flags show 'never' smoking status and 'none' for alcohol risk (AUDIT-C score 1.0), which are positive indicators for overall health, including liver health.\n\nCancer Screening: As a 35-year-old male, there are no current age- or risk-indicated cancer screenings active (e.g., no lung CT due to 'never' smoking, no prostate screening indicated at this age, and no family history of colon cancer). Hard constraints correctly exclude gender-specific screenings like mammography and Pap smears.\n\nVaccination Status: The patient has an 'influenza_vaccination_gap' with a note indicating the last vaccination was approx 5 months ago, with annual revaccination recommended in Q4 2026. This is categorized as 'Green' priority, meaning it is not immediately overdue but should be planned for later in the year. Due to an empty `add_on_library` in the current ruleset, this cannot be formally added as an `add_on` at this time but should be a point of discussion during the consultation.\n\nBehavioral Profile: The patient is a 'never' smoker, engages in 'moderate' physical activity (3 days/week), and has 'none' for alcohol risk, all supporting a healthy lifestyle.\n\nMissing Signals: Several signals are noted as missing, including 'alt_status', 'ast_status', 'tsh_status', 'uric_acid_status', 'est_gap', 'echo_gap', 'hepatitis_b_vaccination_status', 'dm_organ_complication_screening', 'fibroscan_indication', and 'sleep_apnea_screen_result'. While 'tg_status' is listed as missing in signals, the patient's current triglyceride value (100.0 mg/dL) is available and normal in biomarker trends. The absence of a hepatitis B vaccination status and a sleep apnea screen result represent clinically significant gaps that could be considered for future evaluation to ensure comprehensive health assessment.\n\nOverall, the patient presents a healthy profile with no significant risk factors warranting escalation beyond the 'Standard' tier.", "decision": "Standard"}, "how": {"model_provider": "gemini", "model_id": "gemini-2.5-flash"}, "confidence": null, "metadata": {"environment": "dev"}, "previous_hash": "bd5d5cfddb73fbbd3a445abafae2214b42848c3b733441ca1d65d0cf99323eb1", "current_hash": "10020ac1ee46686ef329e03300b7221644648860742aa770c66e07ce0480a8d1"}
