# --- Pluggable AI Configuration (TOR §4.3) ---
# AI_ACTIVE_CLIENT selects the active BAML client. No code deployment needed to switch.
# Valid values: GPT4o | Claude35Sonnet | LocalLlama | NavaveijClient
AI_ACTIVE_CLIENT=GPT4o

# --- Named Client Credentials (architecture-spec clients) ---
# GPT4o client
OPENAI_API_KEY=sk-openai-key

# Claude35Sonnet client
ANTHROPIC_API_KEY=sk-ant-key

# LocalLlama client — no API key needed (Ollama runs locally)
# Base URL defaults to http://localhost:11434/v1

# --- POC Implementation Client (NavaveijClient) ---
# Custom OpenAI-compatible proxy (TrollLLM or any compatible provider)
LLM_API_KEY=sk-trollllm-key
LLM_BASE_URL=https://chat.trollllm.xyz/v1/
LLM_MODEL=gpt-5-mini
# AnnotationModel uses the same proxy but can target a smaller/faster model independently
LLM_ANNOTATION_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=sk-or-v1-key
OPENROUTER_MODEL=openai/gpt-oss-120b

LLM_TIMEOUT_MS=20000

# --- MCP Server Configuration ---
MCP_SERVER_COMMAND=uv
MCP_SERVER_ARGS=["run", "python", "-m", "src.mcp_server.server"]

# --- General Settings ---

ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API_AUTH_MODE options: poc_claims | smart_on_fhir_demo | disabled
# smart_on_fhir_demo: validates mock Bearer JWT from /login consent screen (TOR §5.1 demo)
API_AUTH_MODE=smart_on_fhir_demo
API_AUTH_DEFAULT_USER_ID=usr-admin-00001
API_AUTH_DEFAULT_ROLE=admin
API_AUTH_DEFAULT_SCOPES=recommendation:read,recommendation:write,monitoring:read

RECOMMENDATION_ALLOWED_ROLES=physician,nurse,pharmacist,admin,dpo
RECOMMENDATION_REQUIRED_SCOPES=recommendation:read

MONITORING_ALLOWED_ROLES=admin,dpo
MONITORING_REQUIRED_SCOPES=monitoring:read

CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_REGISTRY_TTL_SECONDS=300
CACHE_RULESET_TTL_SECONDS=300
CACHE_SIGNAL_STORE_TTL_SECONDS=120
CACHE_RECOMMENDATION_TTL_SECONDS=300
