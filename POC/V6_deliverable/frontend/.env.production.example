# Vercel Environment Variables — Production
# Set these in: Vercel Dashboard > Project > Settings > Environment Variables > Production

# ── Backend URL (server-side only) ──────────────────────────────────────────
# The URL of the backend server. Used by Next.js API Route Handlers to proxy
# requests from /api/proxy/* and /api/stream/* to the backend.
# NOT prefixed with NEXT_PUBLIC_ so it is never exposed to the browser.
BACKEND_URL=http://your-backend-host:8000

# ── CORS ────────────────────────────────────────────────────────────────────
# Since all API requests now go through Next.js proxy routes, the backend
# only needs to accept requests from itself. However, if you call the
# backend directly for debugging, add the origin to CORS_ALLOWED_ORIGINS:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
#   docker compose up -d --force-recreate

# ── /api/auth/context note ───────────────────────────────────────────────────
# The frontend calls GET /api/auth/context as a relative URL.
# This resolves to a Next.js API Route (not proxied to the backend).
# If the route does not exist, the frontend silently falls back to a hardcoded admin
# context (api.ts). This is acceptable for the POC.

