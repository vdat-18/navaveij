# Secrets — never bake into image
.env
.env.*
!.env.example

# Frontend — separate deployment target (Vercel)
frontend/

# Logs — volume mounted at runtime
logs/

# Python caches
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/

# uv caches
.uv/

# Git
.git/
.gitignore

# Editor
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Docker files (not needed inside image)
Dockerfile
docker-compose.yml
.dockerignore

# Docs and scripts
*.md
start_backend.sh
start_frontend.sh
