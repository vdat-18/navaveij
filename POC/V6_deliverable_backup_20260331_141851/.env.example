# --- Pluggable AI Configuration (TOR §4.3) ---
# AI_ACTIVE_CLIENT selects the active BAML client AND the per-model prompt template set.
# Changing this value (+ service restart) is the only step needed to switch models.
# Valid values: GeminiClient | OpenAIClient | AnthropicClient | OpenRouterClient | LocalHostedClient
AI_ACTIVE_CLIENT=GeminiClient

# --- Shared runtime ---
LLM_TIMEOUT_MS=20000

# --- GeminiClient — Google AI Gemini (primary) ---
GOOGLE_API_KEY=your-google-ai-key
GEMINI_MODEL=gemini-3-flash-preview

# --- OpenAIClient ---
OPENAI_API_KEY=sk-openai-key
OPENAI_MODEL=gpt-5.4-mini

# --- AnthropicClient ---
ANTHROPIC_API_KEY=sk-ant-key
ANTHROPIC_MODEL=claude-haiku-4-5

# --- OpenRouterClient ---
OPENROUTER_API_KEY=sk-or-v1-key
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- LocalHostedClient — Ollama/local OpenAI-compatible endpoint ---
LOCALHOSTED_BASE_URL=http://localhost:11434/v1
LOCALHOSTED_API_KEY=ollama
LOCALHOSTED_MODEL=llama-3.3-70b-instruct

# --- MCP Server Configuration ---
MCP_SERVER_COMMAND=uv
MCP_SERVER_ARGS=["run", "python", "-m", "src.mcp_server.server"]

# --- General Settings ---

ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API_AUTH_MODE options: poc_claims | smart_on_fhir_demo | disabled
# smart_on_fhir_demo: validates mock Bearer JWT from /login consent screen (TOR §5.1 demo)
API_AUTH_MODE=smart_on_fhir_demo
API_AUTH_DEFAULT_USER_ID=usr-admin-00001
API_AUTH_DEFAULT_ROLE=admin
API_AUTH_DEFAULT_SCOPES=recommendation:read,recommendation:write,monitoring:read

RECOMMENDATION_ALLOWED_ROLES=physician,nurse,pharmacist,admin,dpo
RECOMMENDATION_REQUIRED_SCOPES=recommendation:read

MONITORING_ALLOWED_ROLES=admin,dpo
MONITORING_REQUIRED_SCOPES=monitoring:read

CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_REGISTRY_TTL_SECONDS=300
CACHE_RULESET_TTL_SECONDS=300
CACHE_SIGNAL_STORE_TTL_SECONDS=120
CACHE_RECOMMENDATION_TTL_SECONDS=300
