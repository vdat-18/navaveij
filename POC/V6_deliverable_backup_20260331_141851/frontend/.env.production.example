# Vercel Environment Variables — Production
# Set these in: Vercel Dashboard > Project > Settings > Environment Variables > Production
# These are NEXT_PUBLIC_ variables, meaning they are inlined at build time.
# After updating them in Vercel, you must trigger a redeploy for changes to take effect.

# Base URL of the deployed backend Docker container (must be publicly reachable from the browser)
NEXT_PUBLIC_API_URL_V1=https://your-backend-host/api/v1
NEXT_PUBLIC_API_URL=https://your-backend-host/api

# ── CORS ────────────────────────────────────────────────────────────────────
# After getting your Vercel domain, add it to CORS_ALLOWED_ORIGINS in the
# backend .env, then restart the container:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
#   docker compose up -d --force-recreate

# ── /api/auth/context note ───────────────────────────────────────────────────
# The frontend calls GET /api/auth/context as a relative URL (no base URL prefix).
# This resolves to https://your-app.vercel.app/api/auth/context — a Next.js API Route.
# If the route does not exist, the frontend silently falls back to a hardcoded admin
# context (api.ts lines 124-128). This is acceptable for the POC.
