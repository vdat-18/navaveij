# Navaveij Environment Configuration (Example)

# --- AI Model Configuration (OpenAI Compatible) ---

# Your OpenAI-compatible API key (TrollLLM, OpenAI, local, etc.)
LLM_API_KEY=sk-...

# The base URL for the API endpoint (MUST end with /v1 or similar depending on the proxy)
# Example for TrollLLM: https://chat.trollllm.xyz/v1
# Example for OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://chat.trollllm.xyz/v1

# The model name you wish to use
# Example: gpt-4o, claude-3-5-sonnet, gemini-1.5-flash
LLM_MODEL=gpt-4o

# --- MCP Server Configuration ---
MCP_SERVER_COMMAND=uv
MCP_SERVER_ARGS=["run", "python", "-m", "src.mcp_server.server"]

# --- General Settings ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
API_AUTH_MODE=poc_claims
API_AUTH_DEFAULT_USER_ID=usr-admin-00001
API_AUTH_DEFAULT_ROLE=admin
API_AUTH_DEFAULT_SCOPES=recommendation:read,recommendation:write,monitoring:read
RECOMMENDATION_ALLOWED_ROLES=physician,nurse,pharmacist,admin,dpo
RECOMMENDATION_REQUIRED_SCOPES=recommendation:read
MONITORING_ALLOWED_ROLES=admin,dpo
MONITORING_REQUIRED_SCOPES=monitoring:read
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_REGISTRY_TTL_SECONDS=300
CACHE_RULESET_TTL_SECONDS=300
CACHE_SIGNAL_STORE_TTL_SECONDS=120
CACHE_RECOMMENDATION_TTL_SECONDS=300
