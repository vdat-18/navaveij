<h3 local-id=3D"7e094fca87b6" id=3D"TechnicalProposal-SmartHealthCheckupRec=
ommendationDashboard-9.1.3Network&amp;SecurityTopology">9.1.3 Network &amp;=
 Security Topology</h3>
<p local-id=3D"b7f6c3fcd332">All inter-container communication occurs over =
Docker's internal bridge network. Only the Nginx reverse proxy is exposed t=
o the hospital's internal LAN.</p>
<div>
We don't have a way to export this macro.
</div>
<div id=3D"expander-1139321641" class=3D"expand-container">
<div id=3D"expander-control-1139321641" class=3D"expand-control">
<span class=3D"expand-control-icon"><img style=3D"vertical-align:middle;" c=
lass=3D"expand-control-image" src=3D"12d6790ad24896d77c6798d608975ef510283c=
c49b55e6f0ab90f21b044efffb" width=3D"16" height=3D"16"></span><span class=
=3D"expand-control-text">mermaid</span>
</div>
<div id=3D"expander-content-1139321641" class=3D"expand-content">
<div class=3D"code panel pdl" style=3D"border-width: 1px;">
<div class=3D"codeContent panelContent pdl">
<pre class=3D"syntaxhighlighter-pre" data-syntaxhighlighter-params=3D"brush=
: java; gutter: false; theme: Confluence" data-theme=3D"Confluence">    sub=
graph AppServer ["Application Server"]
        Proxy["=F0=9F=8C=90 Nginx Reverse Proxy&lt;br&gt;:443 (TLS Terminat=
ion)"]
       =20
        subgraph App_Containers ["Application Containers"]
            FE["=F0=9F=96=A5=EF=B8=8F frontend&lt;br&gt;React SPA (nginx:al=
pine)&lt;br&gt;:80"]
            API["=E2=9A=99=EF=B8=8F backend-api&lt;br&gt;FastAPI&lt;br&gt;:=
3000"]
            MCP["=F0=9F=A4=96 mcp-server&lt;br&gt;MCP Server&lt;br&gt;:3001=
"]
            AIGw["=F0=9F=9A=AA ai-gateway&lt;br&gt;Model Router&lt;br&gt;:3=
002"]
            Auth["=F0=9F=94=91 auth-server&lt;br&gt;SMART on FHIR&lt;br&gt;=
:8080"]
        end

        subgraph Observability ["Observability Stack"]
            Prom["=F0=9F=93=8A Prometheus&lt;br&gt;:9090"]
            Graf["=F0=9F=93=88 Grafana&lt;br&gt;:3100"]
            Loki["=F0=9F=93=9D Loki&lt;br&gt;(Log Aggregation)"]
            OtelCol["=F0=9F=94=AD OTel Collector&lt;br&gt;:4317"]
        end
    end

    subgraph DBServer ["Database Server"]
        FHIR_DB[(=F0=9F=8F=A5 fhir-db&lt;br&gt;PostgreSQL :5432&lt;br&gt;cl=
inical_fhir +&lt;br&gt;masked_clinical_fhir)]
        Trend_DB[(=F0=9F=93=88 trending-db&lt;br&gt;ClickHouse :9440&lt;br&=
gt;AI Feature Store)]
        Audit_DB[(=F0=9F=93=9C audit-db&lt;br&gt;PostgreSQL :5434&lt;br&gt;=
Immutable Audit Logs)]
    end

    Internet(("=F0=9F=8C=8D External AI APIs&lt;br&gt;(OpenAI / Anthropic)"=
))

    Proxy --&gt; FE
    Proxy --&gt; API
    API --&gt; MCP
    API --&gt; AIGw
    API --&gt; Auth
    MCP --&gt; FHIR_DB
    MCP --&gt; Trend_DB
    AIGw --&gt;|Masked Prompts| Internet
    Auth --&gt; FHIR_DB
    API --&gt; Audit_DB

    OtelCol --&gt; Prom
    OtelCol --&gt; Loki
    Prom --&gt; Graf
    Loki --&gt; Graf</pre>
