<th data-local-id=3D"5eb16ab7-7c64-4a03-aece-d53c2d3f4487" class=3D"conflue=
nceTh">
<p local-id=3D"2b7915ad8df6">Assumed Value</p></th>
</tr>
<tr data-local-id=3D"62aac969-f74d-4ff4-8685-b4e49621d772">
<td data-local-id=3D"c0aa266d-e7d8-48c4-8e6d-dbd4ff46b59e" class=3D"conflue=
nceTd">
<p local-id=3D"3114116c696c"><strong>Total Healthcare Providers</strong></p=
></td>
<td data-local-id=3D"46677491-326f-478a-ac69-3451f91c232b" class=3D"conflue=
nceTd">
<p local-id=3D"8a78296d6132">30 users in total</p></td>
</tr>
<tr data-local-id=3D"f3733141-055c-4f05-9554-67fe46cb8a69">
<td data-local-id=3D"5c265902-df5d-4b30-8544-178b50ad8cad" class=3D"conflue=
nceTd">
<p local-id=3D"94918bf57d75"><strong>Concurrent Users</strong></p></td>
<td data-local-id=3D"fa17c6c6-1484-45a2-bceb-75a3ccb8b525" class=3D"conflue=
nceTd">
<p local-id=3D"ac17a7014d35">30 healthcare providers using the dashboard si=
multaneously (peak)</p></td>
</tr>
<tr data-local-id=3D"d94d1bb0-09f2-44a6-b028-90b911b63cb3">
<td data-local-id=3D"c2bad14b-8083-444c-8540-1ae8f4b33163" class=3D"conflue=
nceTd">
<p local-id=3D"33a96c2ea4d3"><strong>AI Recommendation Prompts</strong></p>=
</td>
<td data-local-id=3D"570cb457-f104-4bb5-8d24-d9b8942ca769" class=3D"conflue=
nceTd">
<p local-id=3D"9a7663fd52ae">30 prompts per user per day =C3=97 30 users =
=3D <strong>900 prompts/day</strong> (Gemini 1.5 Pro API calls)</p></td>
