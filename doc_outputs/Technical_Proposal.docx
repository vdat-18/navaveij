--&gt; NP2["=F0=9F=A4=96 MCP&lt;br&gt;Data Fetch&lt;br&gt;~1.5s"]
        NP2 --&gt; NP3["=F0=9F=94=92 Freshness&lt;br&gt;Check&lt;br&gt;~300=
ms"]
